# -------------------------------------------------------
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
# -------------------------------------------------------

# Server
PORT=3000

# Department name shown in the sidebar and page title on the home page
DEPT_NAME=Richland Township Fire Department

# Secret token required in the URL: /report?token=YOUR_TOKEN_HERE
# Use a long random string — e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORT_TOKEN=replace-with-a-long-random-string

# Allowed embedding domains (comma-separated, include scheme).
# Leave blank to allow requests from any origin (useful during development).
# Example: https://yoursite.com,https://www.yoursite.com
ALLOWED_DOMAINS=

# Timezone for report display — used to convert UTC timestamps to local time.
# Use an IANA timezone name. PostgreSQL handles DST automatically.
# Examples: America/New_York, America/Chicago, America/Denver, America/Los_Angeles
REPORT_TIMEZONE=America/Detroit

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_username
DB_PASSWORD=your_password
# Set to true if your PostgreSQL server requires SSL (e.g. cloud-hosted)
DB_SSL=false
